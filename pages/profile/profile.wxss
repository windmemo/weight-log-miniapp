.seg {
  display: flex;
  background: #f0f2ee;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 8rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #6d756e;
  border-radius: 10rpx;
}

.seg-item.active {
  background: #ffffff;
  color: #2f6b4f;
  font-weight: 600;
}

.input-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e6e9e4;
  padding-bottom: 10rpx;
  margin-top: 12rpx;
}

.input {
  flex: 1;
  font-size: 34rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.unit-suffix {
  font-size: 28rpx;
  color: #6d756e;
}

.bmi-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2ee;
}

.bmi-row {
  display: flex;
  align-items: baseline;
}

.bmi-num {
  font-size: 56rpx;
  font-weight: 600;
  color: #2f6b4f;
  letter-spacing: -1rpx;
}

.bmi-tag {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #2f6b4f;
  background: #eef3ef;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.bmi-line {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4a534c;
}

.bmi-line.muted {
  color: #8a9089;
  font-size: 24rpx;
  line-height: 1.6;
}

.basis-toggle {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #2f6b4f;
}

.basis {
  margin-top: 12rpx;
  background: #f7f8f5;
  border-radius: 12rpx;
  padding: 16rpx;
}

.basis-p {
  font-size: 24rpx;
  color: #4a534c;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.basis-warn {
  font-size: 24rpx;
  color: #7a5c33;
  line-height: 1.7;
}

.save-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.sub-line {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a9089;
}

.tip {
  margin-top: 14rpx;
  line-height: 1.6;
  font-size: 22rpx;
}

.privacy {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4a534c;
  line-height: 1.8;
}

.clear-btn {
  margin-top: 24rpx;
}

.foot {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
}

.dialog-body {
  font-size: 26rpx;
  color: #4a534c;
  margin: 18rpx 0 12rpx;
  line-height: 1.7;
}

.dialog-backup {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: #f4f5f2;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #6d756e;
  word-break: break-all;
}

.dialog-btn {
  margin-top: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
