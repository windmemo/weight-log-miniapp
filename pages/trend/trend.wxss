.seg {
  display: flex;
  background: #f0f2ee;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #6d756e;
  border-radius: 10rpx;
}

.seg-item.active {
  background: #ffffff;
  color: #2f6b4f;
  font-weight: 600;
}

.custom {
  background: #f7f8f5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.custom-row {
  display: flex;
  align-items: center;
}

.custom-picker {
  flex: 1;
}

.date-box {
  background: #ffffff;
  border-radius: 10rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1f2620;
}

.custom-sep {
  padding: 0 16rpx;
  color: #8a9089;
  font-size: 24rpx;
}

.apply-btn {
  margin-top: 16rpx;
  height: 76rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.chart-caption {
  font-size: 24rpx;
  color: #8a9089;
  margin: 4rpx 0 10rpx;
}

.chart-wrap {
  width: 100%;
  height: 420rpx;
}

.chart {
  width: 100%;
  height: 420rpx;
}

.chart-empty {
  padding: 48rpx 0;
}

.chart-foot {
  margin-top: 8rpx;
}

.rec {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2ee;
}

.rec:last-child {
  border-bottom: none;
}

.rec-left {
  display: flex;
  flex-direction: column;
}

.rec-date {
  font-size: 28rpx;
}

.rec-note {
  font-size: 22rpx;
  color: #9aa39b;
  margin-top: 4rpx;
}

.rec-weight {
  font-size: 32rpx;
  font-weight: 600;
  color: #2f6b4f;
}
